# Window snapshots and runtime logs may contain private app/window details.
/test/*.json
/test/*.jsonl

# Curated acceptance results contain no personal app titles, URLs, or input.
!/test/placement-mode-results.json
!/test/chrome-background-results.json
!/test/chrome-focus-initial.json
!/test/chrome-focus-helper.json
!/test/chrome-fixed-background.json
