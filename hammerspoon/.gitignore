# Screen Recording was unavailable; this diagnostic only contains wallpaper.
/test/chrome-side-screen-capture-unavailable.png

# Locally built test app; keep its source files, not the compiled bundle.
/test/CUWindowProbe.app/
/test/.native-runtime-*/
/test/.native-runtime-lightweight-current
/test/.native-runtime-obsidian-background-current
/test/.obsidian-incident-private/

# Historical copies of the fixed-screen prototype are kept out of the release.
/test_only_mover.lua*
/test/test_only_mover.*.lua
